{
  "name": "hello22-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Express + Prisma API for hello22.ai",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:sync": "prisma db push --accept-data-loss",
    "render:build": "prisma generate && prisma db push --accept-data-loss && tsc -p tsconfig.json",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "create-admin": "tsx scripts/createAdmin.ts",
    "ensure-admin": "tsx scripts/ensureAdmin.ts",
    "backfill-cards": "tsx scripts/backfillCardFingerprints.ts",
    "reset-impersonation-pin": "tsx scripts/resetImpersonationPin.ts",
    "activate-summaries": "tsx scripts/activateSummaryChannels.ts",
    "migrate-capture-fields": "tsx scripts/migrateCaptureFields.ts",
    "refresh-email-templates": "tsx scripts/refreshEmailTemplates.ts",
    "backfill-recordings": "tsx scripts/backfillRecordingIds.ts",
    "backfill-greetings": "tsx scripts/backfillGreetings.ts",
    "rename-business": "tsx scripts/renameBusinessMentions.ts",
    "backfill-business-hours": "tsx scripts/backfillBusinessHours.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1074.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hello22": "file:..",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "stripe": "^17.5.0",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
